<?xml version="1.0" encoding="utf-8"?>
<!-- The app only ever talks to the harness server over the Tailscale VPN
     (MagicDNS name or 100.x tailnet IP), which serves plain HTTP on port
     4520 next to HTTPS on 8443, so cleartext is permitted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
