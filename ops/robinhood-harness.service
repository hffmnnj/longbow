[Unit]
Description=Robinhood trading harness (Pi Durable agent + UI on :4520)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/robinhood-harness/apps/server
Environment=HARNESS_TAILNET_HOST=100.101.102.103
Environment=HARNESS_ORIGINS=https://longbow.example.ts.net:8443,http://longbow.example.ts.net:4520
Environment=HARNESS_BIND=0.0.0.0
# Owner go-live 2026-10-25: "Make it run live now 24/7 as a service on my machine."
Environment=HARNESS_LIVE_TRADING=1
ExecStart=/usr/bin/env node src/main.ts
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
